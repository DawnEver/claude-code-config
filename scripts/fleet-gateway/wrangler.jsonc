// The fleet gateway Worker. The domain and FLEET_CONFIG are not here: deploy.mjs derives both
// from the shared bridge.fleetGateway config, so this file stays generic.
{
  "name": "agent-fleet",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "public", "not_found_handling": "none" },
  "durable_objects": { "bindings": [{ "name": "FLEET", "class_name": "FleetHub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FleetHub"] }],
  "observability": { "enabled": true }
}
