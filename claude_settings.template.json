{
    "syncClaudeAiSkills": false,
    "env": {
        "CLAUDE_CODE_WORKFLOWS": "1",
        "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
        "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
        "CLAUDE_CODE_FORK_SUBAGENT": "1",
        "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1"
    },
    "includeCoAuthoredBy": false,
    "permissions": {
        "allow": [
            "Bash",
            "Read",
            "Edit",
            "Write",
            "PowerShell",
            "WebSearch",
            "Skill(rem:rem)",
            "Skill(rem:todo)",
            "Skill(fabric:continue)",
            "Skill(fabric:models)",
            "Skill(fabric:handoff)",
            "mcp__plugin_fabric_fabric__call",
            "mcp__plugin_fabric_fabric__list_providers",
            "Glob",
            "Grep",
            "WebFetch",
            "Monitor",
            "NotebookEdit",
            "Bash(rm -rf .claude/worktrees/*)",
            "Bash(git worktree remove *)",
            "Bash(git worktree prune)",
            "mcp__session-bridge__send_attachment",
            "mcp__session-bridge__reply"
        ],
        "deny": [
            "Bash(rm -rf /*)",
            "Bash(rm -rf ~*)",
            "Bash(rm -rf .git*)",
            "Bash(rm -rf ..*)",
            "Bash(sudo *)",
            "Bash(curl * | bash)",
            "Bash(git push --force*)",
            "Bash(git reset --hard*)"
        ],
        "defaultMode": "auto"
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/sync-hook.js --pull",
                        "timeout": 90
                    },
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/prune-cache-hook.js",
                        "timeout": 10,
                        "async": true
                    },
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/setup-check-hook.js",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/setup/doctor.js --hook",
                        "timeout": 10
                    },
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/bridge/ensure.mjs",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/notify-hook.js",
                        "async": true
                    }
                ]
            },
            {
                "matcher": "permission_prompt|idle_prompt|elicitation_dialog",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/sync-hook.js --remind",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/loop-guard-hook.js",
                        "timeout": 5
                    }
                ]
            },
            {
                "matcher": "AskUserQuestion",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js --question",
                        "timeout": 660
                    }
                ]
            },
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 10
                    }
                ]
            }
        ],
        "StopFailure": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 10,
                        "async": true
                    }
                ]
            }
        ]
    },
    "worktree": {
        "baseRef": "fresh"
    },
    "enableArtifact": false,
    "statusLine": {
        "type": "command",
        "command": "node ~/.claude/scripts/hooks/hud-hook.js"
    },
    "enabledPlugins": {
        "claude-hud@claude-hud": false,
        "rem@cc-market": true,
        "sharp-review@cc-market": true,
        "evolve@cc-market": true,
        "fabric@cc-market": true,
        "cc-plugin-you-should-know@builtin": true
    },
    "extraKnownMarketplaces": {
        "claude-hud": {
            "source": {
                "source": "github",
                "repo": "jarrodwatts/claude-hud"
            },
            "autoUpdate": true
        },
        "cc-market": {
            "source": {
                "source": "github",
                "repo": "DawnEver/cc-market"
            },
            "autoUpdate": true
        }
    },
    "effortLevel": "low",
    "modelSettings": {
        "deepseek-v4-flash": {
            "effortLevel": "medium"
        },
        "claude-opus-5-5": {
            "effortLevel": "low"
        }
    },
    "autoCompactWindow": 720000,
    "askUserQuestionTimeout": "10m",
    "autoUpdatesChannel": "latest",
    "tui": "fullscreen",
    "skipDangerousModePermissionPrompt": true,
    "skipWorkflowUsageWarning": true,
    "theme": "auto",
    "editorMode": "normal",
    "verbose": true,
    "preferredNotifChannel": "auto",
    "autoCompactEnabled": true,
    "showTurnDuration": true,
    "terminalProgressBarEnabled": true,
    "remoteControlAtStartup": true,
    "inputNeededNotifEnabled": true,
    "agentPushNotifEnabled": true,
    "skipAutoPermissionPrompt": true,
    "autoMode": {
        "environment": [
            "$defaults",
            "Source control: <forge-host>/<org> and every repo under it are the user's own trusted remotes; integrate/main is the team integration branch, main is the release branch",
            "Forge hosts (<machine>, ...) and their lab-commons checkouts belong to the user"
        ],
        "allow": [
            "$defaults",
            "The integrator merging a PR into integrate/main locally with git merge --no-ff and pushing it, when the merge message carries a Break-Glass: <reason> trailer (user ruling 2026-10-21: always allowed)",
            "Installing lab-commons git hook shims into a repo's own .git/hooks via `python -m lab_commons.dev.hook_install --install`",
            "Deleting agent worktrees under .claude/worktrees/ (rm -rf .claude/worktrees/*, git worktree remove, git worktree prune)",
            "Reading forge state and opening PRs: `python -m lab_commons.dev.forge queue|status|pr ...`",
            "Closing a PR whose head is already merged into its base (verified with git merge-base --is-ancestor), with a comment naming why, and then deleting its branch through `python -m lab_commons.dev.branchprune delete` (user ruling 2026-10-22: always allowed)",
            "Editing a forge request issue's body to correct a malformed field (e.g. a short sha to the full 40-hex sha) so the forge can serve it",
            "Installing a missing JMAG material card into the local JMAG library (user ruling 2026-10-13)"
        ]
    }
}