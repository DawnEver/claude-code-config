{
    "env": {
        "CLAUDE_CODE_WORKFLOWS": "1",
        "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
        "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
        "CLAUDE_CODE_FORK_SUBAGENT": "1",
        "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
        "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1",
        "TRACEME_SYNC_REMOTE": "Your TRACEME Git Repo"
    },
    "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash",
      "Read",
      "Edit",
      "Write",
      "PowerShell",
      "WebSearch",
      "Skill(update-config)",
      "Skill(rem:rem)",
      "Skill(rem:todo)",
      "Skill(fabric:continue)",
      "Skill(fabric:models)",
      "Skill(fabric:summary)",
      "mcp__plugin_fabric_fabric__call",
      "mcp__plugin_fabric_fabric__list_providers"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(sudo *)",
      "Bash(curl * | bash)"
    ],
    "defaultMode": "auto"
  },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/setup/fix-lsp-windows.js",
                        "timeout": 5
                    },
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/prune-cache-hook.js",
                        "timeout": 10
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/notify-hook.js"
                    }
                ]
            }
        ]
    },
    "worktree": {
        "baseRef": "fresh"
    },
    "enableArtifact": false,
    "statusLine": {
        "type": "command",
        "command": "node ~/.claude/scripts/hooks/hud-hook.js"
    },
    "enabledPlugins": {
        "skill-creator@claude-plugins-official": false,
        "claude-hud@claude-hud": false,
        "typescript-lsp@claude-plugins-official": true,
        "pyright-lsp@claude-plugins-official": true,
        "rem@cc-market": true,
        "sharp-review@cc-market": true,
        "evolve@cc-market": true,
        "traceme@cc-market": true,
        "fabric@cc-market": true
    },
    "extraKnownMarketplaces": {
        "claude-hud": {
            "source": {
                "source": "github",
                "repo": "jarrodwatts/claude-hud"
            },
            "autoUpdate": true
        },
        "cc-market": {
            "source": {
                "source": "github",
                "repo": "DawnEver/cc-market"
            },
            "autoUpdate": true
        }
    },
    "effortLevel": "low",
    "askUserQuestionTimeout": "10m",
    "autoUpdatesChannel": "latest",
    "tui": "fullscreen",
    "skipWorkflowUsageWarning": true,
    "theme": "auto",
    "editorMode": "normal",
    "verbose": true,
    "preferredNotifChannel": "auto",
    "autoCompactEnabled": true,
    "showTurnDuration": true,
    "terminalProgressBarEnabled": true,
    "teammateMode": "auto",
    "remoteControlAtStartup": true,
    "inputNeededNotifEnabled": true,
    "agentPushNotifEnabled": true,
    "skipAutoPermissionPrompt": true,
    "autoMode": {
        "environment": [
            "$defaults"
        ]
    },
    "metadata": {
        "NOTIFY_WAITING_TIMEOUT_MINUTES": 1
    },
  "autoCompactWindow": 720000

}
