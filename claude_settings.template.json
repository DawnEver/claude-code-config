{
    "syncClaudeAiSkills": false,
    "env": {
        "CLAUDE_CODE_WORKFLOWS": "1",
        "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1",
        "CLAUDE_CODE_ENABLE_AUTO_MODE": "1",
        "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
        "CLAUDE_CODE_DISABLE_BG_SHELL_PRESSURE_REAP": "1",
        "CLAUDE_CODE_FORK_SUBAGENT": "1",
        "CLAUDE_AUTO_BACKGROUND_TASKS": "1",
        "DISABLE_ERROR_REPORTING": "1",
        "DISABLE_FEEDBACK_COMMAND": "1",
        "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
        "CLAUDE_CODE_DISABLE_BUNDLED_SKILLS": "1"
    },
    "includeCoAuthoredBy": false,
    "permissions": {
        "allow": [
            "Bash",
            "Read",
            "Edit",
            "Write",
            "PowerShell",
            "WebSearch",
            "Skill(rem:rem)",
            "Skill(rem:todo)",
            "Skill(fabric:continue)",
            "Skill(fabric:models)",
            "Skill(fabric:handoff)",
            "mcp__plugin_fabric_fabric__call",
            "mcp__plugin_fabric_fabric__list_providers",
            "Glob",
            "Grep",
            "WebFetch",
            "Monitor",
            "NotebookEdit",
            "Bash(rm -rf .claude/worktrees/*)",
            "Bash(git worktree remove *)",
            "Bash(git worktree prune)",
            "mcp__session-bridge__send_attachment",
            "mcp__session-bridge__reply"
        ],
        "deny": [
            "Bash(rm -rf /*)",
            "Bash(rm -rf ~*)",
            "Bash(rm -rf .git*)",
            "Bash(rm -rf ..*)",
            "Bash(sudo *)",
            "Bash(curl * | bash)",
            "Bash(git push --force*)",
            "Bash(git reset --hard*)"
        ],
        "defaultMode": "auto"
    },
    "hooks": {
        "SessionStart": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "[ -f ~/.claude/scripts/hooks/claude-hook.mjs ] || { node ~/.claude/scripts/hooks/sync-hook.js --pull </dev/null >/dev/null 2>&1; [ -f ~/.claude/scripts/hooks/claude-hook.mjs ] || { if git -C ~/.claude/scripts cat-file -e '@{u}:scripts/hooks/claude-hook.mjs' 2>/dev/null; then w='the pull did not fast-forward this checkout'; else w='its upstream does not carry it yet (offline, or main not yet promoted)'; fi; printf '{\"systemMessage\":\"[claude-hook] SessionStart hooks skipped: claude-hook.mjs is absent and %s. Launch via ccc, or run: node ~/.claude/scripts/hooks/sync-hook.js --pull\"}\\n' \"$w\"; exit 0; }; }; exec node ~/.claude/scripts/hooks/claude-hook.mjs --event SessionStart",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Notification": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "[ -f ~/.claude/scripts/hooks/claude-hook.mjs ] || exit 0; exec node ~/.claude/scripts/hooks/claude-hook.mjs --event Notification",
                        "timeout": 5,
                        "async": true
                    }
                ]
            }
        ],
        "SessionEnd": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/sync-hook.js --remind",
                        "timeout": 5
                    }
                ]
            }
        ],
        "PreToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "[ -f ~/.claude/scripts/hooks/claude-hook.mjs ] || exit 0; exec node ~/.claude/scripts/hooks/claude-hook.mjs --event PreToolUse",
                        "timeout": 5
                    }
                ]
            }
        ],
        "UserPromptSubmit": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 5
                    }
                ]
            }
        ],
        "Stop": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 5
                    }
                ]
            }
        ],
        "StopFailure": [
            {
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 5,
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 5,
                        "async": true
                    }
                ]
            }
        ],
        "PostToolUseFailure": [
            {
                "matcher": "*",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/scripts/hooks/bridge-hook.js",
                        "timeout": 5,
                        "async": true
                    }
                ]
            }
        ]
    },
    "worktree": {
        "baseRef": "fresh"
    },
    "enableArtifact": false,
    "statusLine": {
        "type": "command",
        "command": "node ~/.claude/scripts/hooks/hud-hook.js"
    },
    "enabledPlugins": {
        "claude-hud@claude-hud": false,
        "rem@cc-market": true,
        "sharp-review@cc-market": true,
        "evolve@cc-market": true,
        "fabric@cc-market": true,
        "cc-plugin-you-should-know@builtin": true
    },
    "extraKnownMarketplaces": {
        "claude-hud": {
            "source": {
                "source": "github",
                "repo": "jarrodwatts/claude-hud"
            },
            "autoUpdate": true
        },
        "cc-market": {
            "source": {
                "source": "github",
                "repo": "DawnEver/cc-market"
            },
            "autoUpdate": true
        }
    },
    "effortLevel": "low",
    "modelSettings": {
        "deepseek-v4-flash": {
            "effortLevel": "medium"
        },
        "claude-opus-5-5": {
            "effortLevel": "low"
        }
    },
    "autoCompactWindow": 720000,
    "askUserQuestionTimeout": "10m",
    "autoUpdatesChannel": "latest",
    "tui": "fullscreen",
    "skipDangerousModePermissionPrompt": true,
    "skipWorkflowUsageWarning": true,
    "theme": "auto",
    "editorMode": "normal",
    "verbose": true,
    "preferredNotifChannel": "auto",
    "autoCompactEnabled": true,
    "showTurnDuration": true,
    "terminalProgressBarEnabled": true,
    "remoteControlAtStartup": true,
    "inputNeededNotifEnabled": true,
    "agentPushNotifEnabled": true,
    "skipAutoPermissionPrompt": true
}