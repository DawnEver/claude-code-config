{
  "providers": {
    "deepseek": {
      "claudeApiKeyEnv": "ANTHROPIC_API_KEY",
      "codexApiKeyEnv": "DEEPSEEK_API_KEY"
    }
  },
  "fabric": {
    "sessionDefaults": {
      "provider": "deepseek",
      "model": "deepseek-v4-flash[1m]"
    },
    "systemPromptFile": "~/.claude/system-prompt/claude-base.md"
  },
  "bridge": {
    "fallbackChatId": null,
    "codexSources": ["cli"],
    "projects": {
      "your-repo-name": {
        "chatId": -1001234567890
      }
    }
  },
  "seats": [
    {
      "alias": "team-a",
      "email": "alice@example.com",
      "org": "Team A",
      "machines": [
        "host-a"
      ]
    }
  ]
}
